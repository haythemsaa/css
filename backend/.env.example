# Application
APP_NAME="CSS Club Sportif Sfaxien"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Tunis
APP_LOCALE=fr

# Frontend URLs
FRONTEND_URL=http://localhost:3000
MOBILE_APP_URL=cssapp://

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=css_database
DB_USERNAME=root
DB_PASSWORD=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis

# Cache
CACHE_DRIVER=redis
CACHE_PREFIX=css_cache

# Queue
QUEUE_CONNECTION=redis
QUEUE_PREFIX=css_queue

# Session
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting
BROADCAST_DRIVER=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=eu

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@css-sfax.tn"
MAIL_FROM_NAME="${APP_NAME}"

# SMS (Tunisian SMS Gateway)
SMS_PROVIDER=twilio
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=+21612345678

# AWS S3 (or compatible storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare (CDN)
CLOUDFLARE_API_KEY=
CLOUDFLARE_ZONE_ID=

# Payment Gateways - Tunisia
# D17 Mobile Payment
D17_API_KEY=
D17_API_SECRET=
D17_MERCHANT_ID=
D17_WEBHOOK_SECRET=

# Konnect
KONNECT_API_KEY=
KONNECT_WALLET_ID=
KONNECT_RECEIVER_ID=

# Paymee
PAYMEE_API_KEY=
PAYMEE_TOKEN=

# Sadad
SADAD_MERCHANT_ID=
SADAD_API_KEY=

# International Cards (Stripe fallback)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Social Authentication
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Firebase Cloud Messaging
FCM_SERVER_KEY=
FCM_SENDER_ID=

# Video Streaming
STREAMING_DRIVER=cloudflare
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_ACCOUNT_ID=

# Search Engine
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# Analytics
GOOGLE_ANALYTICS_ID=
MIXPANEL_TOKEN=

# Sentry (Error Tracking)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# Geolocation API
GEOLOCATION_API_KEY=
GEOLOCATION_PROVIDER=google

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PREMIUM=120

# Subscription Pricing (TND)
PREMIUM_MONTHLY_PRICE=15
PREMIUM_YEARLY_PRICE=150

# Freeoui Commission
FREEOUI_COMMISSION_RATE=5

# Lottery Settings
LOTTERY_MAX_TICKETS_PER_USER=10
LOTTERY_TICKET_PRICE=1

# Security
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# CORS
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Telescope
TELESCOPE_ENABLED=true

# Horizon
HORIZON_ENABLED=true
HORIZON_PREFIX=css_horizon

# Log
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
